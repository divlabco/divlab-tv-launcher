<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="4dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="18dp" android:paddingEnd="18dp"
    android:background="@drawable/row_bg" android:focusable="true" android:clickable="true">
    <ImageView android:id="@+id/icon" android:layout_width="22dp" android:layout_height="22dp"
        android:duplicateParentState="true" android:tint="@color/pill_text" android:importantForAccessibility="no" />
    <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:duplicateParentState="true" android:singleLine="true" android:ellipsize="end"
        android:textColor="@color/pill_text" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
    <ImageView android:id="@+id/dot" android:layout_width="7dp" android:layout_height="7dp"
        android:src="@drawable/dot_green" android:visibility="gone" android:importantForAccessibility="no" />
    <TextView android:id="@+id/state" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:duplicateParentState="true"
        android:textColor="@color/row_value" android:textSize="13sp" />
</LinearLayout>
