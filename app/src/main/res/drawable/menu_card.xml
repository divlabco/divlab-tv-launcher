<?xml version="1.0" encoding="utf-8"?>
<!-- frosted dark glass: ทึบพอให้อ่านง่าย แต่ยังเห็นสีด้านหลังจาง ๆ -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><corners android:radius="24dp" /><solid android:color="#E61A1A1F" /></shape></item>
    <item><shape><corners android:radius="24dp" />
        <gradient android:angle="270" android:startColor="#24FFFFFF" android:endColor="#0AFFFFFF" />
        <stroke android:width="1dp" android:color="#40FFFFFF" /></shape></item>
</layer-list>
