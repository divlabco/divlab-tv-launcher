<?xml version="1.0" encoding="utf-8"?>
<!-- glassmorphism: พื้นโปร่งแสงไล่สี + ขอบสว่างบาง + ไฮไลต์ด้านบน -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><corners android:radius="24dp" />
        <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#1AFFFFFF" />
        <stroke android:width="1dp" android:color="#4DFFFFFF" /></shape></item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:height="40dp"><shape>
        <corners android:topLeftRadius="23dp" android:topRightRadius="23dp" />
        <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" /></shape></item>
</layer-list>
